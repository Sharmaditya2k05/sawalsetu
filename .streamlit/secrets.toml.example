# Copy to .streamlit/secrets.toml locally, or paste into the Secrets box on Streamlit Community Cloud.
MARGBOOKS_MODE = "demo"            # demo | live
MARGBOOKS_BASE_URL = "https://openapi.margbooks.com/"
MARGBOOKS_MB_KEY = ""
MARGBOOKS_PARTNER_ID = ""
COMPANY_NAME = "Shree Balaji Distributors"
# LLM: Groq free tier is used when GROQ_API_KEY is set (get one at https://console.groq.com/keys)
GROQ_API_KEY = ""
GROQ_MODEL = "llama-3.3-70b-versatile"
# Optional alternative; leave both keys empty for offline (retrieval-only) answers
ANTHROPIC_API_KEY = ""
CLAUDE_MODEL = "claude-opus-5-5"
CLAUDE_EFFORT = "medium"
