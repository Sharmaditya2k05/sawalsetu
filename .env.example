# ---- MargBooks Open API -------------------------------------------------------
# demo  -> built-in sample dataset shaped like the MargBooks API (no credentials needed)
# live  -> pull from MargBooks with the keys below
MARGBOOKS_MODE=demo
# Production: https://openapi.margbooks.com/   Sandbox: https://uatopenapi.margbooks.com/
MARGBOOKS_BASE_URL=https://openapi.margbooks.com/
# Issued by POST identity/v1/auth/signup (docs: https://openapiweb.margbooks.com -> Get Keys)
MARGBOOKS_MB_KEY=
MARGBOOKS_PARTNER_ID=
# How many months of bills to pull on each sync
MARGBOOKS_SYNC_MONTHS=18

COMPANY_NAME=Shree Balaji Distributors

# ---- Claude -------------------------------------------------------------------
# Leave empty to run in offline (extractive) mode
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# ---- Embeddings (optional; BM25 lexical retrieval always runs) -----------------
# none | voyage | local
EMBEDDINGS_PROVIDER=none
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

RAG_TOP_K=12
